# Don't show directory listings for URLs which map to a directory.
Options -Indexes
#IndexIgnore *.png *.jpg *.pdf *.JPG *.docs *.gif
# Follow symbolic links in this directory.
Options +FollowSymLinks
RewriteRule ^\.well-known/ - [L]
RewriteRule (^|/)\. - [F]

<IfModule mod_rewrite.c>
# Turn on URL rewriting
RewriteEngine On

# If your website begins from a folder e.g localhost/my_project then
# you have to change it to: RewriteBase /my_project/
# If your site begins from the root e.g. example.local/ then
# let it as it is
RewriteBase /ci_project/


# Protect application and system files from being viewed when the index.php is missing
RewriteCond $1 ^(application|system|private|logs)

# Rewrite to index.php/access_denied/URL
RewriteRule ^(.*)$ index.php/access_denied/$1 [PT,L]

# Production host restriction - disabled for local development
#RewriteCond %{HTTP_HOST} !^(.*\.)?a2ascholarships\.iccr\.gov\.in$ [NC]
#RewriteRule .* - [L,R=403]

# Allow these directories and files to be displayed directly:
RewriteCond $1 ^(index\.php|robots\.txt|favicon\.ico|public|assets|css|js|images|2023|2024|2025|2026|2027)

# No rewriting
RewriteRule ^(.*)$ - [PT,L]

# Rewrite to index.php/URL
RewriteRule ^(.*)$ index.php/$1 [PT,L]
Header append X-FRAME-OPTIONS "SAMEORIGIN"
</IfModule>

# Force HTTPS / production-domain redirects - disabled for local development
#<IfModule mod_rewrite.c>
##Rewrite everything to https
#RewriteEngine On
#RewriteCond %{HTTPS} !=on
#RewriteRule ^(.*)$ https://a2ascholarships.iccr.gov.in/$1 [L,R=301]
#</IfModule>

#<IfModule mod_rewrite.c>
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^164\.100\.252\.211$
# RewriteRule ^(.*)$ https://a2ascholarships.iccr.gov.in/$1 [L,R=301]
#</IfModule>


<IfModule mod_headers.c>
        Header set X-Content-Type-Options nosniff
        Header set X-XSS-Protection "1; mode=block"
        Header always set X-FRAME-OPTIONS "SAMEORIGIN"
        Header append X-Firefox-Spdy "h2"
        # Strict-Transport-Security disabled for local development (forces HTTPS in browser)
        #Header append Strict-Transport-Security: 'max-age=31536000; includeSubDomains'
        Header set Access-Control-Allow-Methods "GET, POST, HEAD"
        Header set Server " "
        Header always unset "X-Powered-By"
        Header unset "X-Powered-By"
        Header set Access-Control-Allow-Origin "https://a2ascholarships.iccr.gov.in"
        Header set Access-Control-Allow-Credentials true
        Header set Access-Control-Allow-Headers "accept, content-type, X-Requested-With, X-Prototype-Version, X-CSRF-Token, authorization"
        Header always edit Set-Cookie (.*) "$1; HTTPOnly"
        Header edit Set-Cookie ^(.*)$ "$1;HttpOnly;Samesite=Strict"
        Header set Referrer-Policy "no-referrer"
        Header always set Permissions-Policy "autoplay=()"
        #Header set Content-Security-Policy "default-src 'self'; script-src 'self';"
        # Content Security Policy (UX4G audit: "Ensure CSP is effective against XSS").
        # Starts in REPORT-ONLY mode: nothing is blocked, the browser console lists
        # what WOULD be blocked. Check the main pages (student, Mission, university,
        # HQ, admin), then change "Content-Security-Policy-Report-Only" to
        # "Content-Security-Policy" to enforce it.
        Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' https://www.google.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        # Cache rules for static files are below (mod_expires). Pages themselves are not cached.
</IfModule>

# ---------------------------------------------------------------------------
# Speed (UX4G audit: "Enable text compression", "efficient cache policy")
# ---------------------------------------------------------------------------
# 1. Compress text files before sending them (HTML, CSS, JS, JSON, SVG, XML).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 2. Let browsers keep static files. Images/fonts 30 days, CSS/JS 7 days.
#    After changing a CSS/JS file, add or bump ?v=... in the <link>/<script> tag.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif  "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff  "access plus 30 days"
    ExpiresByType application/font-woff "access plus 30 days"
    ExpiresByType application/vnd.ms-fontobject "access plus 30 days"
    ExpiresByType font/ttf   "access plus 30 days"
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresDefault "access plus 0 seconds"
</IfModule>
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
# 3. HTTP/2 cannot be switched on from .htaccess. The server team must add
#    "Protocols h2 http/1.1" to the Apache SSL virtual host (needs mod_http2).
